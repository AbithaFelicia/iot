.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.env
.env.*
*.log

# Raw datasets and packet captures
data/raw/
captures/
*.pcap
*.pcapng

# Temporary files
.DS_Store

# Exclude large CSV datasets and intermediate results
data/raw/
data/processed/**/*.csv
data/supervised/**/*.csv

# Include dashboard result files
!data/processed/splits/attack_detection_results.csv
!data/supervised/file_based_mitm60k/category_comparison.csv
!data/supervised/file_based_mitm60k/results/hybrid_dt_lr_mitm60k_no_https_predictions.csv
!data/processed/splits/baseline_stats_transformed.csv
# Keep trained models and JSON metrics
!data/processed/splits/*.joblib
!data/supervised/**/*.joblib
!data/supervised/**/*.json

# Local backup files
*.backup
*.py.backup
*_backup.py
*_before_*.py

# Empty supplementary archives
supplementary/*.zip
